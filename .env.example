# ---------- Access ----------
# Set with: npm run set-password   (stores only a scrypt hash, never the password)
APP_PASSWORD_HASH=
AUTH_SECRET=
# Shared secret for /api/cron when a scheduler calls it (Authorization: Bearer <value>)
CRON_SECRET=

# ---------- AI ----------
# Google Gemini: match analysis and Russian club-name normalisation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
AI_CACHE_MINUTES=180

# ---------- Optional data providers ----------
# API-Football supplies xG. Free tier: 100 requests/day and only a rolling
# yesterday..tomorrow window, so xG accumulates day by day and cannot be back-filled.
# Key from dashboard.api-football.com -> leave API_FOOTBALL_HOST empty.
# Key from RapidAPI -> API_FOOTBALL_HOST=rapidapi
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_MIN_GAP_MS=1200
XG_INTERVAL_MIN=180

# The Odds API adds more bookmakers (optional, free tier is 500 credits/month)
ODDS_API_KEY=
ODDS_API_MONTHLY_LIMIT=500
ODDS_API_REGIONS=eu

# ---------- Worker intervals, minutes ----------
LIVE_INTERVAL_MIN=1
ODDS_INTERVAL_MIN=15
NEWS_INTERVAL_MIN=10
SCHEDULE_INTERVAL_MIN=180
STATS_INTERVAL_MIN=30
SPORTS_INTERVAL_MIN=20

# ---------- Politeness toward free hosts ----------
# Both public APIs answer 403/429 when polled too hard; one shared queue per host.
ESPN_MIN_GAP_MS=700
SMARKETS_MIN_GAP_MS=1100

# Commission charged by the exchange on net winnings, used when pricing picks
EXCHANGE_COMMISSION=0.02

# ---------- Misc ----------
# Defaults to ./data/overline.db
DB_PATH=
